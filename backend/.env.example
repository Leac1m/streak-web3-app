# Backend Environment Variables Example

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/ton_streak

# Redis
REDIS_URL=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
JWT_EXPIRY_DAYS=7

# TON (placeholders if needed for future signature verification libs)
TON_NETWORK=testnet

# CORS
CORS_ORIGIN=http://localhost:5173
